# ── ArangoDB ──────────────────────────────────────────────
# Two configurable targets — flip with ARANGO_TARGET and the connection vars.
#   local       → Docker container (docker-compose)
#   arangograph → Arango's managed cloud platform
ARANGO_TARGET=local

# --- local Docker (default) ---
ARANGO_URL=http://localhost:8529
ARANGO_DB=agentic_memory
ARANGO_USERNAME=root
ARANGO_PASSWORD=changeme
ARANGO_TLS_VERIFY=true
# Enterprise image (arangodb/enterprise) requires a license key for full use.
# Runs in evaluation mode without one. NEVER commit the real value.
ARANGO_LICENSE_KEY=

# --- ArangoGraph (managed cloud) — uncomment & fill, set ARANGO_TARGET=arangograph ---
# ARANGO_TARGET=arangograph
# ARANGO_URL=https://<deployment-id>.arangodb.cloud:8529
# ARANGO_DB=agentic_memory
# ARANGO_USERNAME=root
# ARANGO_PASSWORD=<deployment-root-password>
# ARANGO_TLS_VERIFY=true            # ArangoGraph uses publicly-valid certs
# Or authenticate with a bearer/JWT token instead of user/pass:
# ARANGO_BEARER_TOKEN=<jwt>

# ── Embeddings ────────────────────────────────────────────
# Default embedder: OpenAI text-embedding-3-small (1536 dims)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ── Background / extraction LLM ───────────────────────────
# Haiku is used for all background pipeline work (full mode)
ANTHROPIC_API_KEY=
BACKGROUND_MODEL=claude-haiku-4-5

# ── Core service ──────────────────────────────────────────
CORE_HOST=0.0.0.0
CORE_PORT=8080
# Enrichment mode: lite (default, no hot-path LLM) or full
MEMORY_MODE=lite

# ── Vercel adapter ────────────────────────────────────────
# URL the TS middleware uses to reach the Python core
ARANGO_MEMORY_CORE_URL=http://localhost:8080
