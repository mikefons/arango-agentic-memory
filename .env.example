# ── ArangoDB ──────────────────────────────────────────────
# Local Docker (docker-compose) or ArangoGraph cloud URL
ARANGO_URL=http://localhost:8529
ARANGO_DB=agentic_memory
ARANGO_USERNAME=root
ARANGO_PASSWORD=changeme
# For ArangoGraph, use a bearer token instead of user/pass:
# ARANGO_BEARER_TOKEN=
# Enterprise image (arangodb/enterprise) requires a license key.
# Get one from your ArangoDB account / ArangoGraph. NEVER commit the real value.
ARANGO_LICENSE_KEY=

# ── Embeddings ────────────────────────────────────────────
# Default embedder: OpenAI text-embedding-3-small (1536 dims)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ── Background / extraction LLM ───────────────────────────
# Haiku is used for all background pipeline work (full mode)
ANTHROPIC_API_KEY=
BACKGROUND_MODEL=claude-haiku-4-5

# ── Core service ──────────────────────────────────────────
CORE_HOST=0.0.0.0
CORE_PORT=8080
# Enrichment mode: lite (default, no hot-path LLM) or full
MEMORY_MODE=lite

# ── Vercel adapter ────────────────────────────────────────
# URL the TS middleware uses to reach the Python core
ARANGO_MEMORY_CORE_URL=http://localhost:8080
