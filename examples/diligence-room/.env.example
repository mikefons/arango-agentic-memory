# URL of the Python memory core (FastAPI). Local docker-compose default below.
# Use 127.0.0.1 (not localhost): server-side fetch may try IPv6 ::1 and hang.
# No trailing slash (it's stripped anyway). For a hosted core, use its public URL.
CORE_URL=http://127.0.0.1:8080

# Bearer key for the core, REQUIRED only when the core enforces auth (a public
# deployment should). Map this exact key to the Room's tenant + write scope on the
# core (API_KEYS). Leave blank when the core runs keyless (local dev). Never commit.
CORE_API_KEY=

# LLM provider for the specialist / red-team / synthesis agents. Gateway preferred; falls
# back to calling Anthropic directly. With NEITHER set, the War Room runs the canned golden
# replay (no key, no core) — enough for the full demo. Set one to run the campaign live.
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=

# Optional model override for the agents. Defaults to claude-haiku-4-5 (cheap; plenty for
# claim extraction). Anthropic id form, e.g. "claude-haiku-4-5" or "claude-sonnet-4-6".
DILIGENCE_MODEL=
