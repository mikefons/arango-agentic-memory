# URL of the Python memory core (FastAPI). Local docker-compose default.
# Use 127.0.0.1 (not localhost): server-side fetch may try IPv6 ::1 and hang.
CORE_URL=http://127.0.0.1:8080

# Pick ONE of the following to power the DM model:
#
# (a) Vercel AI Gateway — one key, routing + observability. Preferred.
#     Get one at https://vercel.com/ai-gateway. Optional model override: DUNGEON_MODEL.
AI_GATEWAY_API_KEY=
# DUNGEON_MODEL=anthropic/claude-sonnet-4.5
#
# (b) Direct Anthropic fallback — used automatically when AI_GATEWAY_API_KEY is
#     unset. No Gateway account needed. Optional override: DUNGEON_MODEL_DIRECT.
# ANTHROPIC_API_KEY=
# DUNGEON_MODEL_DIRECT=claude-sonnet-4-5
