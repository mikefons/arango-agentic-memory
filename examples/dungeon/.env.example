# URL of the Python memory core (FastAPI). Local docker-compose default.
# Use 127.0.0.1 (not localhost): server-side fetch may try IPv6 ::1 and hang.
# No trailing slash (it's stripped anyway). For a hosted core, use its public URL.
CORE_URL=http://127.0.0.1:8080

# Bearer key for the core, REQUIRED only when the core enforces auth (a public
# deployment should). Set the core's API_KEYS to map this exact key to the app's
# tenant + write scope, e.g. on the core:
#   API_KEYS={"<this-key>":{"tenant_id":"dungeon-player","scope":"write"}}
# Leave blank when the core runs keyless (local dev). Never commit the real value.
CORE_API_KEY=

# Pick ONE of the following to power the DM model:
#
# (a) Vercel AI Gateway — one key, routing + observability. Preferred.
#     Get one at https://vercel.com/ai-gateway. Optional model override: DUNGEON_MODEL.
AI_GATEWAY_API_KEY=
# DUNGEON_MODEL=anthropic/claude-sonnet-4.5
#
# (b) Direct Anthropic fallback — used automatically when AI_GATEWAY_API_KEY is
#     unset. No Gateway account needed. Optional override: DUNGEON_MODEL_DIRECT.
# ANTHROPIC_API_KEY=
# DUNGEON_MODEL_DIRECT=claude-sonnet-4-5

# ── Feature toggles (all OFF by default) ──────────────────────────────
# Turn on via these env vars, or override at runtime with Vercel Edge Config
# (set EDGE_CONFIG + a `dungeon` key holding e.g. {"sceneArt":true,"hint":true}).
# DUNGEON_HINT=1          # DM weaves gentle hints toward unsolved contradictions
# SCENE_ART=1             # generate AI room art (also needs OPENAI_API_KEY + BLOB_READ_WRITE_TOKEN)
# EDGE_CONFIG=            # Vercel Edge Config connection string (optional)
